# Focused MetalFX frame-interpolation quality scene. It keeps the player car,
# spinning wheels, bumpers and several pedestrians in view while the car begins
# moving, and writes generated/real neighbour triplets plus motion/depth inputs.
# Run through route_bench.sh; {out} is replaced with that run's output folder.
await 5m
wait 10s
nowanted
invincible
clock 13 0
weather 1
road 1040 150 20
car sultan
wait 4s
peds 12 0 12
wait 6s

set gta4_metalfx_frame_generation_dump {out}/framegen
set gta4_metalfx_frame_generation_dump_every 10
set gta4_metalfx_frame_generation_dump_max 24
mark framegen
drive 12 0
wait 10s
mark framegen_end
shot {out}/shots/framegen-end.png 0.5
where
wait 1s
quit
