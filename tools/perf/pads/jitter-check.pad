# MetalFX jitter sign check: the save loads indoors (a still scene). For each sign of the jitter
# handed to MetalFX (gta4_metalfx_jitter_sign), a burst of 8 shots; tools/perf/jitter_stability.py
# compares how much edges move from shot to shot. The wrong sign doubles the jitter instead of
# cancelling it, and a still scene shakes. Two rounds, interleaved.
await 5m
wait 15s
set gta4_metalfx_jitter_sign ++
wait 3s
shot {out}/shots/jit-1-pp-0.png
wait 120ms
shot {out}/shots/jit-1-pp-1.png
wait 120ms
shot {out}/shots/jit-1-pp-2.png
wait 120ms
shot {out}/shots/jit-1-pp-3.png
wait 120ms
shot {out}/shots/jit-1-pp-4.png
wait 120ms
shot {out}/shots/jit-1-pp-5.png
wait 120ms
shot {out}/shots/jit-1-pp-6.png
wait 120ms
shot {out}/shots/jit-1-pp-7.png
wait 120ms
set gta4_metalfx_jitter_sign --
wait 3s
shot {out}/shots/jit-1-mm-0.png
wait 120ms
shot {out}/shots/jit-1-mm-1.png
wait 120ms
shot {out}/shots/jit-1-mm-2.png
wait 120ms
shot {out}/shots/jit-1-mm-3.png
wait 120ms
shot {out}/shots/jit-1-mm-4.png
wait 120ms
shot {out}/shots/jit-1-mm-5.png
wait 120ms
shot {out}/shots/jit-1-mm-6.png
wait 120ms
shot {out}/shots/jit-1-mm-7.png
wait 120ms
set gta4_metalfx_jitter_sign -+
wait 3s
shot {out}/shots/jit-1-mp-0.png
wait 120ms
shot {out}/shots/jit-1-mp-1.png
wait 120ms
shot {out}/shots/jit-1-mp-2.png
wait 120ms
shot {out}/shots/jit-1-mp-3.png
wait 120ms
shot {out}/shots/jit-1-mp-4.png
wait 120ms
shot {out}/shots/jit-1-mp-5.png
wait 120ms
shot {out}/shots/jit-1-mp-6.png
wait 120ms
shot {out}/shots/jit-1-mp-7.png
wait 120ms
set gta4_metalfx_jitter_sign +-
wait 3s
shot {out}/shots/jit-1-pm-0.png
wait 120ms
shot {out}/shots/jit-1-pm-1.png
wait 120ms
shot {out}/shots/jit-1-pm-2.png
wait 120ms
shot {out}/shots/jit-1-pm-3.png
wait 120ms
shot {out}/shots/jit-1-pm-4.png
wait 120ms
shot {out}/shots/jit-1-pm-5.png
wait 120ms
shot {out}/shots/jit-1-pm-6.png
wait 120ms
shot {out}/shots/jit-1-pm-7.png
wait 120ms
set gta4_metalfx_jitter_sign ++
wait 3s
shot {out}/shots/jit-2-pp-0.png
wait 120ms
shot {out}/shots/jit-2-pp-1.png
wait 120ms
shot {out}/shots/jit-2-pp-2.png
wait 120ms
shot {out}/shots/jit-2-pp-3.png
wait 120ms
shot {out}/shots/jit-2-pp-4.png
wait 120ms
shot {out}/shots/jit-2-pp-5.png
wait 120ms
shot {out}/shots/jit-2-pp-6.png
wait 120ms
shot {out}/shots/jit-2-pp-7.png
wait 120ms
set gta4_metalfx_jitter_sign --
wait 3s
shot {out}/shots/jit-2-mm-0.png
wait 120ms
shot {out}/shots/jit-2-mm-1.png
wait 120ms
shot {out}/shots/jit-2-mm-2.png
wait 120ms
shot {out}/shots/jit-2-mm-3.png
wait 120ms
shot {out}/shots/jit-2-mm-4.png
