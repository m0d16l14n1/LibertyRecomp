shot {out}/shots/jit-2-mp-0.png
wait 120ms
shot {out}/shots/jit-2-mp-1.png
wait 120ms
shot {out}/shots/jit-2-mp-2.png
wait 120ms
shot {out}/shots/jit-2-mp-3.png
wait 120ms
shot {out}/shots/jit-2-mp-4.png
wait 120ms
shot {out}/shots/jit-2-mp-5.png
wait 120ms
shot {out}/shots/jit-2-mp-6.png
wait 120ms
shot {out}/shots/jit-2-mp-7.png
wait 120ms
set gta4_metalfx_jitter_sign +-
wait 3s
shot {out}/shots/jit-2-pm-0.png
wait 120ms
shot {out}/shots/jit-2-pm-1.png
wait 120ms
shot {out}/shots/jit-2-pm-2.png
